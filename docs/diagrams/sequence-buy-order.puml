@startuml
' Sequence diagram for US04 - Place a market buy order
title US04 - Place a market buy order

actor Investor
participant "Trade UI" as UI
participant "Order Service" as Orders
participant "Price Service" as Prices
database "Account Store" as Store

autonumber

Investor -> UI : submit buy order(symbol, quantity)
activate UI
UI -> Orders : placeBuyOrder(symbol, quantity)
activate Orders
Orders -> Prices : getLatestPrice(symbol)
Prices --> Orders : latest quote
Orders -> Store : getAvailableCash()
Store --> Orders : available cash
Orders -> Orders : calculate order value

alt order value <= available cash
  Orders -> Store : debit cash(order value)
  Store --> Orders : cash updated
  Orders -> Store : upsert holding(symbol, quantity, price)
  Store --> Orders : holding updated
  note right of Store
    Recalculate weighted average cost (BR6)
  end note
  Orders -> Store : record BUY transaction
  Store --> Orders : transaction recorded
  Orders --> UI : order filled(price, remaining cash)
  UI --> Investor : show confirmation
else order value > available cash
  Orders --> UI : reject "Insufficient cash" (BR1)
  UI --> Investor : show error message
end

deactivate Orders
deactivate UI

note over Investor, Store
  Example: 1,000 HPG at 28,000 VND costs 28,000,000 VND;
  100,000,000 VND cash becomes 72,000,000 VND.
end note

@enduml
