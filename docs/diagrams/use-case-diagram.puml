@startuml
' Use Case Diagram - Investment & Portfolio Management Simulation
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F7F9FC
  BorderColor #263238
  ArrowColor #455A64
}

title Investment & Portfolio Management Simulation - Use Case Diagram

actor Investor as investor
actor "Market Data Provider" as market
actor "Notification Service" as notify

rectangle "Investment & Portfolio Management Simulation" {
  usecase "Register / log in" as UC01
  usecase "Receive initial virtual capital" as UC02
  usecase "View current market price" as UC03
  usecase "Place market buy order" as UC04
  usecase "Place market sell order" as UC05
  usecase "View portfolio holdings" as UC06
  usecase "Set stop-loss / take-profit" as UC07
  usecase "View transaction history" as UC08
  usecase "View portfolio performance" as UC09
  usecase "Compare with benchmark index" as UC11
  usecase "Receive balance warning" as UC10
  usecase "View performance leaderboard" as UC12

  usecase "Validate available cash" as ValidateCash
  usecase "Validate held quantity" as ValidateQuantity
  usecase "Fill order at latest quote" as FillOrder
  usecase "Update weighted average cost" as UpdateCost
  usecase "Trigger threshold order" as TriggerThreshold
}

investor --> UC01
investor --> UC03
investor --> UC04
investor --> UC05
investor --> UC06
investor --> UC07
investor --> UC08
investor --> UC09
investor --> UC11
investor --> UC12

market --> UC03
market --> FillOrder
notify --> TriggerThreshold
notify --> UC10

UC04 .> ValidateCash : <<include>>
UC04 .> FillOrder : <<include>>
UC04 .> UpdateCost : <<include>>
UC05 .> ValidateQuantity : <<include>>
UC05 .> FillOrder : <<include>>
UC07 .> TriggerThreshold : <<include>>
UC10 .> ValidateCash : <<extend>>
UC11 .> UC09 : <<extend>>

note right of UC02
  Every new account receives
  exactly 100,000,000 VND (BR5).
end note

note bottom of UC04
  US04, BR1, BR3, BR6
end note
note bottom of UC05
  US05, BR2, BR3
end note
note bottom of UC07
  US07, BR4
end note

@enduml
