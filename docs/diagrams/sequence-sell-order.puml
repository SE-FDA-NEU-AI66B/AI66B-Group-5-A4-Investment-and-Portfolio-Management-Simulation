@startuml
' Sequence diagram for US05 - Place a market sell order
title US05 - Place a market sell order

actor Investor
participant "Trade UI" as UI
participant "Order Service" as Orders
participant "Price Service" as Prices
database "Account Store" as Store

autonumber

Investor -> UI : submit sell order(symbol, quantity)
activate UI
UI -> Orders : placeSellOrder(symbol, quantity)
activate Orders
Orders -> Store : getHeldQuantity(symbol)
Store --> Orders : held quantity

alt quantity <= held quantity
  Orders -> Prices : getLatestPrice(symbol)
  Prices --> Orders : latest quote at submission
  Orders -> Store : credit cash(proceeds)
  Store --> Orders : cash updated
  Orders -> Store : reduce holding(symbol, quantity)
  Store --> Orders : holding updated
  Orders -> Store : record SELL transaction and realised P&L
  Store --> Orders : transaction recorded
  Orders --> UI : order filled(price, proceeds)
  UI --> Investor : show confirmation
else quantity > held quantity
  Orders --> UI : reject "You hold X; maximum sell is X" (BR2)
  UI --> Investor : show error message
end

deactivate Orders
deactivate UI

note over Investor, Store
  Example: sell 1,000 HPG bought at 28,000 VND
  when quoted at 30,000 VND; realised P&L is +2,000,000 VND.
end note

@enduml
