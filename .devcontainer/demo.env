# Codespaces practice market. postCreate copies this to .env only if .env is missing.
HOST=0.0.0.0
PORT=5000
QUOTE_MODE=simulation
DATABASE_PATH=instance/simulation.db
MARKET_FEED=simulation
SIMULATION_TICK_SECONDS=20
# Codespaces serves the forwarded port through its own HTTPS proxy.
TRUST_PROXY=1
SECRET_KEY=
