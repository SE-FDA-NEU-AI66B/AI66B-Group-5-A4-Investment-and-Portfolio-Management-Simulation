{
  // GitHub Codespaces / VS Code Dev Containers setup.
  // Python 3.12 matches CI. The project venv is put first on PATH so the
  // literal `pytest -v` runs the venv's pytest (which can import virtutrade
  // and Flask) instead of the image's global pipx pytest (#146).
  // The app opens on the practice market (.devcontainer/demo.env), so orders
  // work at any hour; .env is copied only if it does not exist yet.
  "name": "VirtuTrade (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev]' && { [ -f .env ] || cp .devcontainer/demo.env .env; } && { .venv/bin/python -m virtutrade init-demo || true; } && .venv/bin/python -m virtutrade seed-test-accounts",
  "postAttachCommand": ".venv/bin/python -m virtutrade run",
  "remoteEnv": {
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {"label": "VirtuTrade", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
