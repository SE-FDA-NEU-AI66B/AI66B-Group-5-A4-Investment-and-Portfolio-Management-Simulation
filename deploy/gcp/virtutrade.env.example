# Copied to /etc/virtutrade/virtutrade.env (mode 640, root:virtutrade) by setup.sh.
# Edit there, then: sudo systemctl restart virtutrade-web virtutrade-feed

DATABASE_PATH=/var/lib/virtutrade/dnse.db
# Caddy terminates HTTPS in front of gunicorn on 127.0.0.1:8000.
TRUST_PROXY=1
# setup.sh writes a random value here; keep it so sessions survive restarts.
SECRET_KEY=

# Real market data with a key: QUOTE_MODE=dnse, FEED_COMMAND=stream and both DNSE values.
# Real market data without a key (unofficial public endpoint): QUOTE_MODE=dnse,
# FEED_COMMAND=public-feed.
# Practice market without credentials: QUOTE_MODE=simulation, FEED_COMMAND=simulate
# and a different DATABASE_PATH (DNSE and simulation prices never share a database).
QUOTE_MODE=dnse
FEED_COMMAND=public-feed
# The separate feed service runs the feed, so the web process must not.
MARKET_FEED=off
SIMULATION_TICK_SECONDS=20

DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_SYMBOLS=
