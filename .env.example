DATABASE_PATH=instance/virtutrade.db
HOST=127.0.0.1
PORT=5000

# seed = offline examples; dnse = provider quotes only; simulation = generated demo.
# For simulation use a NEW instance/simulation.db path, separate from DNSE.
QUOTE_MODE=seed
# Signs login sessions and CSRF tokens. Leave empty for local development:
# the app then mints a fresh random key on every boot, so tokens cannot be
# forged from this public file. Set a long random value only for a shared or
# production deployment, and never commit real keys.
SECRET_KEY=

# Optional market-data worker; never commit real values.
DNSE_API_KEY=
DNSE_API_SECRET=
# Empty subscribes to every instrument already in the database (up to 66:
# three streams each, inside DNSE's 200 streams per connection).
DNSE_SYMBOLS=

# Running behind exactly one HTTPS reverse proxy (Caddy, Render, Codespaces):
# set 1 so cookies stay Secure and the login origin check sees the public host.
# Never set it when the app is reachable directly.
TRUST_PROXY=
# Market feed inside the web process: off (default), dnse (signed, needs the keys
# above), dnse-public (real DNSE candles from the public chart endpoint, no keys,
# unofficial; use QUOTE_MODE=dnse) or simulation.
# Use it on single-service hosts; with a separate stream/simulate process keep off.
MARKET_FEED=off
# Seconds between simulated price moves (orders must confirm within one move).
SIMULATION_TICK_SECONDS=20
