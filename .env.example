DATABASE_PATH=instance/virtutrade.db
HOST=127.0.0.1
PORT=5000

# seed = offline examples; dnse = provider quotes only; simulation = generated demo.
# For simulation use a NEW instance/simulation.db path, separate from DNSE.
QUOTE_MODE=seed
# Signs login sessions and CSRF tokens. Leave empty for local development:
# the app then mints a fresh random key on every boot, so tokens cannot be
# forged from this public file. Set a long random value only for a shared or
# production deployment, and never commit real keys.
SECRET_KEY=

# Optional market-data worker; never commit real values.
DNSE_API_KEY=
DNSE_API_SECRET=
# Empty subscribes to every instrument already in the database (up to 100).
DNSE_SYMBOLS=
